{
  "compilerOptions": {
    "target": "ES2020",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": true,
    "declaration": true,
    "declarationMap": true,
    "lib": ["ES2020"],
    "outDir": "build",
    "rootDir": "src",
    "inlineSourceMap": true,
    "noEmitOnError": true,
    "strict": false,
    "types": ["node"]
  },
  "include": ["src/**/*.js"]
}
