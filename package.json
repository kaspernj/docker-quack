{
  "name": "docker-quack",
  "version": "0.0.19",
  "description": "Docker Engine API client with HTTP keep-alive for Node.js",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "lint": "npm run eslint && npm run typecheck",
    "test": "velocious test spec --ignore spec/integration",
    "test:integration": "velocious test spec/integration",
    "typecheck": "tsc --noEmit",
    "release:patch": "release-patch",
    "eslint": "eslint src spec"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-jsdoc": "^63.0.0",
    "glob": "^13.0.6",
    "globals": "^17.6.0",
    "release-patch": "^1.0.0",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1",
    "typescript": "^7.0.2",
    "velocious": "1.0.559"
  },
  "dependencies": {
    "snapreq": "0.0.10"
  }
}
